---
title: Contact — Millennium Consulting Georgia
pageRelPath: contact.html
bodyClass: contact-page
metaDesc: Get in touch with Millennium Consulting Georgia for export, import, sourcing and brand development in wine, spirits and general trade. Inquiries reach Levan Kurdadze directly.
---

<div class="about-bg-art" aria-hidden="true">
  <span class="about-glow about-glow-1"></span>
  <span class="about-glow about-glow-2"></span>
  <svg viewBox="0 0 1200 500" preserveAspectRatio="xMidYMid slice" fill="none">
    <g stroke="#009ACE" stroke-width="1" stroke-dasharray="4 7" opacity="0.5">
      <path d="M60 380 Q 320 120 620 260 T 1160 160"/>
      <path d="M120 60 Q 400 300 760 200 T 1140 420"/>
    </g>
    <g fill="#009ACE" opacity="0.7">
      <circle cx="60" cy="380" r="3.5"/>
      <circle cx="620" cy="260" r="3.5"/>
      <circle cx="1160" cy="160" r="3.5"/>
      <circle cx="120" cy="60" r="3.5"/>
      <circle cx="760" cy="200" r="3.5"/>
      <circle cx="1140" cy="420" r="3.5"/>
    </g>
  </svg>
</div>

<section class="contact-hero">
  <div class="container">
    <span class="about-eyebrow">{{ en.contactPage.hero.eyebrow }}</span>
    <h1 class="contact-h1">{{ en.contactPage.hero.heading }}</h1>
    <p class="contact-lead">{{ en.contactPage.hero.lead }}</p>

    <div class="contact-cta-row">
      <a class="btn btn-primary" href="{{ en.contactPage.hero.cta_email_href }}">{{ en.contactPage.hero.cta_email }}</a>
      <a class="btn" href="#book">{{ en.contactPage.hero.cta_book }}</a>
      <a class="btn" href="{{ en.contactPage.hero.cta_linkedin_href }}" target="_blank" rel="noopener">{{ en.contactPage.hero.cta_linkedin }}</a>
    </div>

    <div class="contact-details">
      {% for card in en.contactPage.details %}
      <div class="contact-card">
        <div class="contact-card-label">{{ card.label }}</div>
        {% if card.href %}
          <a class="contact-card-value" href="{{ card.href }}"{% if card.external %} target="_blank" rel="noopener"{% endif %}>{{ card.value }}</a>
        {% else %}
          <div class="contact-card-value">{{ card.value }}</div>
        {% endif %}
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="contact-book" id="book">
  <div class="container">
    <div class="contact-book-head">
      <span class="about-eyebrow">{{ en.contactPage.booking.eyebrow }}</span>
      <h2 class="contact-book-h2">{{ en.contactPage.booking.heading }}</h2>
      <p class="contact-book-lead">{{ en.contactPage.booking.lead }}</p>
    </div>
    <div class="contact-book-actions">
      <button class="btn btn-primary" id="contact-cal-btn" aria-expanded="false" aria-controls="contact-scheduler">{{ en.contactPage.booking.button_open }}</button>
    </div>
    <div class="contact-scheduler" id="contact-scheduler" aria-hidden="true">
      <div class="iframe-wrap">
        <iframe src="{{ en.contactPage.booking.iframe_src }}" loading="lazy" referrerpolicy="no-referrer-when-downgrade" scrolling="no"></iframe>
      </div>
    </div>
  </div>
</section>

<script>
(function(){
  var btn = document.getElementById('contact-cal-btn');
  var panel = document.getElementById('contact-scheduler');
  if (!btn || !panel) return;
  btn.addEventListener('click', function(){
    var open = panel.classList.toggle('open');
    panel.setAttribute('aria-hidden', open ? 'false' : 'true');
    btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    btn.textContent = open ? '{{ en.contactPage.booking.button_close }}' : '{{ en.contactPage.booking.button_open }}';
    if (open) { panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' }); }
  });
})();
</script>
