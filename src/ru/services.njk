---
title: Услуги — Millennium Consulting Georgia
pageRelPath: services.html
bodyClass: services-page
---

<div class="about-bg-art" aria-hidden="true">
  <svg viewBox="0 0 1200 800" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <radialGradient id="sg1" cx="50%" cy="50%" r="50%"><stop offset="0%" stop-color="#009ACE" stop-opacity="0.16"/><stop offset="100%" stop-color="#009ACE" stop-opacity="0"/></radialGradient>
      <radialGradient id="sg2" cx="50%" cy="50%" r="50%"><stop offset="0%" stop-color="#009ACE" stop-opacity="0.10"/><stop offset="100%" stop-color="#009ACE" stop-opacity="0"/></radialGradient>
    </defs>
    <circle cx="180" cy="160" r="320" fill="url(#sg1)"/>
    <circle cx="1040" cy="660" r="380" fill="url(#sg2)"/>
    <g stroke="#009ACE" stroke-width="1" fill="none" stroke-dasharray="5 9" stroke-opacity="0.5">
      <path d="M120 240 C 360 120, 720 360, 1080 200"/>
      <path d="M80 560 C 420 660, 760 420, 1120 600"/>
      <path d="M200 420 C 500 380, 760 520, 1060 440"/>
    </g>
    <g fill="#009ACE" fill-opacity="0.7">
      <circle cx="120" cy="240" r="3.5"/>
      <circle cx="1080" cy="200" r="3.5"/>
      <circle cx="80" cy="560" r="3.5"/>
      <circle cx="1120" cy="600" r="3.5"/>
      <circle cx="500" cy="380" r="2.5"/>
      <circle cx="760" cy="520" r="2.5"/>
    </g>
  </svg>
</div>

<section class="svc-intro">
  <div class="container">
    <p class="eyebrow">{{ ru.servicesPage.hero.eyebrow }}</p>
    <h1>{{ ru.servicesPage.hero.h1 }}</h1>
    <p class="lead">{{ ru.servicesPage.hero.lead }}</p>
  </div>
</section>

<section class="svc-rows">
  <div class="container">
    <p style="font-size:12px;letter-spacing:.04em;color:var(--muted);margin:0 0 6px;">{{ ru.servicesPage.hero.hint }} &darr;</p>

    {% for svc in ru.servicesPage.services %}
    <details id="{{ svc.id }}" class="svc-item{% if svc.reverse %} reverse{% endif %}"{% if svc.open %} open{% endif %}>
      <summary class="svc-head">
        <div class="svc-h-copy">
          <p class="svc-h-eyebrow">{{ svc.eyebrow }}</p>
          <h2 class="svc-h-title">{{ svc.title }}</h2>
          <p class="svc-h-sum">{{ svc.summary }}</p>
        </div>
        <div class="svc-h-right">
          <div class="svc-chip">
            <div class="n">{{ svc.chip.n }}{% if svc.chip.nSup %}<small>{{ svc.chip.nSup }}</small>{% endif %}</div>
            <div class="c">{{ svc.chip.c }}</div>
          </div>
          <span class="svc-toggle" aria-hidden="true"></span>
        </div>
      </summary>
      <div class="svc-body">
        <div class="svc-grid2">
          <div class="svc-detail">
            <p>{{ svc.detail.intro }}</p>
            {% for block in svc.detail.blocks %}
            <div class="svc-block">
              <h4>{{ block.heading }}</h4>
              {% if block.pills %}
              <div class="svc-pills">
                {% for pill in block.pills %}<span>{{ pill }}</span>{% endfor %}
              </div>
              {% endif %}
              {% if block.steps %}
              <ol class="svc-steps">
                {% for step in block.steps %}<li>{{ step }}</li>{% endfor %}
              </ol>
              {% endif %}
            </div>
            {% endfor %}
          </div>
          <div class="svc-proof">
            <span class="svc-proof-label">{{ ru.ui.track_record_label }}</span>
            <p>{{ svc.proof.text }}</p>
            <div class="svc-proof-src"><b>{{ svc.proof.sourceName }}</b> &nbsp;&middot;&nbsp; {{ svc.proof.sourceDetail }}</div>
          </div>
        </div>
      </div>
    </details>
    {% endfor %}

  </div>
</section>

<section class="cta-band">
  <div class="container">
    <h2>{{ ru.servicesPage.cta.heading }}</h2>
    <p>{{ ru.servicesPage.cta.lead }}</p>
    <a class="btn btn-primary" href="contact.html">{{ ru.servicesPage.cta.button }}</a>
  </div>
</section>

<script>
(function () {
  function openFromHash() {
    var hash = location.hash.slice(1);
    if (!hash) return;
    var el = document.getElementById(hash);
    if (el && el.tagName === 'DETAILS') {
      el.open = true;
      el.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }
  openFromHash();
  window.addEventListener('hashchange', openFromHash);
})();
</script>
