---
title: "Контакты | Millennium Consulting Georgia"
pageRelPath: contact.html
bodyClass: contact-page
metaDesc: "Свяжитесь с Millennium Consulting Georgia: выход на рынок, поиск поставщиков вина и крепкого алкоголя, маркетинг и развитие бренда. Тбилиси, Грузия."
---

<div class="about-bg-art" aria-hidden="true">
  <span class="about-glow about-glow-1"></span>
  <span class="about-glow about-glow-2"></span>
  <svg viewBox="0 0 1200 500" preserveAspectRatio="xMidYMid slice" fill="none">
    <g stroke="#009ACE" stroke-width="1" stroke-dasharray="4 7" opacity="0.5">
      <path d="M60 380 Q 320 120 620 260 T 1160 160"/>
      <path d="M120 60 Q 400 300 760 200 T 1140 420"/>
    </g>
    <g fill="#009ACE" opacity="0.7">
      <circle cx="60" cy="380" r="3.5"/>
      <circle cx="620" cy="260" r="3.5"/>
      <circle cx="1160" cy="160" r="3.5"/>
      <circle cx="120" cy="60" r="3.5"/>
      <circle cx="760" cy="200" r="3.5"/>
      <circle cx="1140" cy="420" r="3.5"/>
    </g>
  </svg>
</div>

<section class="contact-hero">
  <div class="container">
    <div class="contact-hero-grid">

      <div class="contact-hero-main">
        <span class="about-eyebrow">{{ ru.contactPage.hero.eyebrow }}</span>
        <h1 class="contact-h1">{{ ru.contactPage.hero.heading }}</h1>
        <p class="contact-lead">{{ ru.contactPage.hero.lead }}</p>

        <div class="contact-cta-row">
          <a class="btn btn-primary" href="{{ ru.contactPage.hero.cta_email_href }}">{{ ru.contactPage.hero.cta_email }}</a>
          <a class="btn" href="#book">{{ ru.contactPage.hero.cta_book }}</a>
          <a class="btn" href="{{ ru.contactPage.hero.cta_linkedin_href }}" target="_blank" rel="noopener">{{ ru.contactPage.hero.cta_linkedin }}</a>
        </div>

        <div class="contact-details">
          {% for card in ru.contactPage.details %}
          <div class="contact-card">
            <div class="contact-card-label">{{ card.label }}</div>
            {% if card.href %}
              <a class="contact-card-value" href="{{ card.href }}"{% if card.external %} target="_blank" rel="noopener"{% endif %}>{{ card.value }}</a>
            {% else %}
              <div class="contact-card-value">{{ card.value }}</div>
            {% endif %}
          </div>
          {% endfor %}
        </div>
      </div>

      <aside class="contact-reach-card">
        <div class="contact-reach-head">{{ ru.contactPage.reach_card.heading }}</div>
        {% for row in ru.contactPage.reach_card.rows %}
        <a class="contact-reach-row" href="{{ row.href }}">
          <span class="contact-reach-text">{{ row.title | safe }}<small>{{ row.sub }}</small></span>
          <span class="contact-reach-arrow" aria-hidden="true">&rarr;</span>
        </a>
        {% endfor %}
      </aside>

    </div>
  </div>
</section>

<section class="contact-book" id="book">
  <div class="container">
    <div class="contact-book-head">
      <span class="about-eyebrow">{{ ru.contactPage.booking.eyebrow }}</span>
      <h2 class="contact-book-h2">{{ ru.contactPage.booking.heading }}</h2>
      <p class="contact-book-lead">{{ ru.contactPage.booking.lead }}</p>
    </div>
    <div class="contact-book-actions">
      <button class="btn btn-primary" id="contact-cal-btn" aria-expanded="false" aria-controls="contact-scheduler">{{ ru.contactPage.booking.button_open }}</button>
    </div>
    <div class="contact-scheduler" id="contact-scheduler" aria-hidden="true">
      <div class="iframe-wrap">
        <iframe src="{{ ru.contactPage.booking.iframe_src }}" loading="lazy" referrerpolicy="no-referrer-when-downgrade" scrolling="no"></iframe>
      </div>
    </div>
  </div>
</section>

<script>
(function(){
  var btn = document.getElementById('contact-cal-btn');
  var panel = document.getElementById('contact-scheduler');
  if (!btn || !panel) return;
  btn.addEventListener('click', function(){
    var open = panel.classList.toggle('open');
    panel.setAttribute('aria-hidden', open ? 'false' : 'true');
    btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    btn.textContent = open ? '{{ ru.contactPage.booking.button_close }}' : '{{ ru.contactPage.booking.button_open }}';
    if (open) { panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' }); }
  });
})();
</script>
